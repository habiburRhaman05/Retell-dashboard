[Unit]
Description=Reconcile Retell call limit phone routes
After=retell-dashboard.service

[Service]
Type=oneshot
User=retell-dashboard
Group=retell-dashboard
WorkingDirectory=/opt/retell-dashboard
EnvironmentFile=/etc/retell-dashboard.env
Environment=APP_URL=http://127.0.0.1:3000
ExecStart=/opt/retell-dashboard/scripts/reconcile-call-limits.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
